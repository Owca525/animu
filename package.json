{
  "name": "animu",
  "version": "0.8.0",
  "description": "Simple Application To Watch Anime",
  "main": "./out/main/index.js",
  "author": "Owca525",
  "homepage": "https://github.com/Owca525/animu",
  "scripts": {
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "dev:web": "ANIMU_WEB_DEV=true ANIMU_WEB=true electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:web": "ANIMU_WEB=true electron-vite build",
    "build:install": "npm run build:linux && python3 install.py",
    "build:plugins": "ONLY_PLUGINS=true electron-vite build"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@solid-primitives/keyboard": "^1.3.3",
    "@solidjs/router": "^0.16.1",
    "@xhayper/discord-rpc": "^1.3.3",
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "bonjour": "^3.5.1",
    "castv2-client": "^1.2.0",
    "cheerio": "^1.2.0",
    "electron-app-universal-protocol-client": "https://github.com/Owca525/electron-app-universal-protocol-client.git",
    "electron-updater": "^6.8.3",
    "hls.js": "^1.6.15",
    "html2canvas": "^1.4.1",
    "ini": "^6.0.0",
    "jassub": "1.8.8",
    "js-sha256": "^0.11.1",
    "material-symbols": "^0.43.0",
    "semver": "^7.7.4",
    "socket.io-client": "^4.8.3",
    "subtitle-converter": "^3.0.12",
    "uuid": "^13.0.0",
    "video.js": "^8.23.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^7.0.0",
    "@types/cheerio": "^1.0.0",
    "@types/crypto-js": "^4.2.2",
    "@types/ini": "^4.1.1",
    "@types/node": "^25.5.0",
    "@types/semver": "^7.7.1",
    "@types/video.js": "^7.3.58",
    "bufferutil": "^4.1.0",
    "electron": "41.1.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.0.3",
    "eslint-plugin-solid": "^0.14.5",
    "node-addon-api": "^8.7.0",
    "solid-js": "^1.9.12",
    "typescript": "^6.0.2",
    "utf-8-validate": "^6.0.6",
    "vite": "7.3.1",
    "vite-plugin-solid": "^2.11.6",
    "vite-plugin-static-copy": "^3.2.0"
  }
}
