{
  "name": "animu",
  "version": "0.8.0",
  "description": "Simple Application To Watch Anime",
  "main": "./out/main/index.js",
  "author": "Owca525",
  "homepage": "https://github.com/Owca525/animu",
  "scripts": {
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "dev:web": "ANIMU_WEB_DEV=true ANIMU_WEB=true electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:web": "ANIMU_WEB=true electron-vite build",
    "build:install": "npm run build:linux && python3 install.py",
    "build:plugins": "ONLY_PLUGINS=true electron-vite build"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@solidjs/router": "^0.16.2",
    "@xhayper/discord-rpc": "^1.3.3",
    "adm-zip": "^0.6.0",
    "electron-app-universal-protocol-client": "https://github.com/Owca525/electron-app-universal-protocol-client.git",
    "electron-updater": "^6.8.9",
    "hls.js": "^1.6.16",
    "jassub": "1.8.8",
    "material-symbols": "^0.45.8",
    "semver": "^7.8.5",
    "shaka-player": "^5.2.2",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/adm-zip": "^0.5.8",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.1.1",
    "@types/semver": "^7.7.1",
    "@types/video.js": "^7.3.58",
    "bufferutil": "^4.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.7.0",
    "eslint-plugin-solid": "^0.14.5",
    "node-addon-api": "^8.9.0",
    "solid-js": "^1.9.14",
    "typescript": "^7.0.2",
    "utf-8-validate": "^6.0.6",
    "vite": "^8.1.5",
    "vite-plugin-solid": "^2.11.13"
  }
}
